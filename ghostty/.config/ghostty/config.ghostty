theme = dark:Gruvbox Dark Hard, light: Gruvbox Light Hard

window-width = 130
window-height = 35

background-opacity = 0.9
background-blur = 15

font-family = "FiraCode"
font-style = Regular
font-size = 15
font-feature = liga
font-thicken = true
font-thicken-strength = 1
adjust-cell-height = 1

shell-integration = zsh
shell-integration-features = no-cursor

cursor-style = bar
copy-on-select = clipboard

macos-option-as-alt = true
macos-titlebar-style = tabs

keybind = super+r=reload_config

keybind = super+shift+1=goto_tab:1
keybind = super+shift+2=goto_tab:2
keybind = super+shift+3=goto_tab:3
keybind = super+shift+4=goto_tab:4
keybind = super+shift+5=goto_tab:5
